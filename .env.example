# Copy to .env for a new installation; preserve an existing .env.
EMQX_DASHBOARD_PASSWORD=REPLACE_WITH_A_STRONG_DASHBOARD_PASSWORD
# Generate once, e.g. openssl rand -hex 32. Keep stable across container recreations.
# Existing installations: keep the node cookie already in use.
EMQX_NODE_COOKIE=REPLACE_WITH_A_RANDOM_NODE_COOKIE
