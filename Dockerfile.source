FROM node:22-alpine AS frontend
WORKDIR /src/web
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:1.26-alpine AS backend
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/web/dist ./web/dist
RUN CGO_ENABLED=0 go build -trimpath -o /out/uart_sms_forwarder ./cmd/serv

FROM alpine:3.22
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
ENV TZ=Asia/Hong_Kong
COPY --from=backend /out/uart_sms_forwarder ./uart_sms_forwarder
RUN mkdir -p /app/data /app/logs
EXPOSE 8080
ENTRYPOINT ["./uart_sms_forwarder"]
